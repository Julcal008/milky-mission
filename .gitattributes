# Normalize line endings for a mixed Linux + Windows team.
# The repository stores LF; Windows checkouts keep LF so diffs never churn.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff2 binary
*.ico binary
*.pdf binary

*.svg text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
